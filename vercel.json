{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/api/markets", "destination": "/api/markets.json" },
    { "source": "/api/ticks", "destination": "/api/ticks.json" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
